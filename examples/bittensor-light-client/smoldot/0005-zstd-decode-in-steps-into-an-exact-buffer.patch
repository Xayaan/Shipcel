 /// Error possibly returned when decoding a zstd-compressed Wasm blob.
diff --git a/lib/src/executor/host/zstd/tests.rs b/lib/src/executor/host/zstd/tests.rs
index fbbfcc5..b53c85b 100644
--- a/lib/src/executor/host/zstd/tests.rs
+++ b/lib/src/executor/host/zstd/tests.rs
@@ -55,3 +55,29 @@ fn basic_works_with_header() {
     )
     .unwrap();
 }
+
+#[test]
+fn same_as_decoding_the_whole_frame_at_once() {
+    let compressed =
+        &include_bytes!("./polkadot-runtime-v9160.wasm.zstd")[super::ZSTD_PREFIX.len()..];
+    let mut source = compressed;
+    let mut decoder = ruzstd::decoding::FrameDecoder::new();
+    decoder.init(&mut source).unwrap();
+    assert!(
+        decoder
+            .decode_blocks(&mut source, ruzstd::decoding::BlockDecodingStrategy::All)
+            .unwrap()
+    );
+    let whole = decoder.collect().unwrap();
+
+    let streamed = super::zstd_decode(compressed, 50 * 1024 * 1024).unwrap();
+    assert_eq!(streamed, whole);
+    assert_eq!(streamed.capacity(), streamed.len());
+
+    // The limit is the output's size, inclusive.
+    assert_eq!(super::zstd_decode(compressed, whole.len()).unwrap(), whole);
+    assert!(matches!(
+        super::zstd_decode(compressed, whole.len() - 1),
+        Err(super::Error::TooLarge)
+    ));
+}
