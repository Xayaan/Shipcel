+        let mut out = Vec::new();
+        let mut buf = [0u8; 7000];
+        loop {
+            match reader.read(&mut buf) {
+                Ok(0) => return Ok(out),
+                Ok(n) => out.extend_from_slice(&buf[..n]),
+                Err(_) => return Err(reader.failed.clone().unwrap()),
+            }
+        }
+    };
