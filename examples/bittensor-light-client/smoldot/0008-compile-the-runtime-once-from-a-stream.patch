+// Patch (Shipcel's Bittensor light client): a compressed runtime that the interpreter compiles
+// lazily is read as a stream, never decompressed whole. These hints take that path.
+const STREAMED: [ExecHint; 2] = [
+    ExecHint::CompileWithNonDeterministicValidation,
+    ExecHint::ExecuteOnceWithNonDeterministicValidation,
+];
+
+#[test]
+fn streamed_invalid_zstd() {
+    let module_bytes = &[82, 188, 83, 118, 70, 219, 142, 5, 6, 7, 8, 9, 10];
+    for exec_hint in STREAMED {
+        match HostVmPrototype::new(Config {
+            allow_unresolved_imports: false,
+            exec_hint,
+            heap_pages: HeapPages::new(1024),
+            module: &module_bytes,
+        }) {
+            Err(NewErr::BadFormat(ModuleFormatError::InvalidZstd)) => {}
+            _ => panic!(),
+        }
+    }
+}
+
+#[test]
+fn streamed_compressed_runtime_is_the_same_runtime() {
+    // Polkadot's runtime, zstd-compressed with the Substrate prefix, carries its version in
+    // custom sections.
+    let module = &include_bytes!("../zstd/polkadot-runtime-v9160.wasm.zstd")[..];
+    let build = |exec_hint| {
+        HostVmPrototype::new(Config {
+            allow_unresolved_imports: true,
+            exec_hint,
+            heap_pages: HeapPages::new(2048),
+            module,
+        })
+        .unwrap()
+    };
+    // The same interpreter, compiling lazily too, from the module decompressed whole.
+    let whole = build(ExecHint::ForceWasmi {
+        lazy_validation: true,
+    });
+    for exec_hint in STREAMED {
+        let streamed = build(exec_hint);
+        assert_eq!(
+            streamed.runtime_version().as_ref(),
+            whole.runtime_version().as_ref()
+        );
+        // And it runs the same: `Core_version` and the metadata, byte for byte.
+        for function in ["Core_version", "Metadata_metadata"] {
+            assert_eq!(
+                run(streamed.clone(), function),
+                run(whole.clone(), function)
+            );
+        }
+    }
+}
+
+// Runs `function` without parameters and returns its output.
+fn run(prototype: HostVmPrototype, function: &str) -> Vec<u8> {
+    let mut vm: super::super::HostVm = prototype
+        .run_no_param(
+            function,
+            super::super::StorageProofSizeBehavior::proof_recording_disabled(),
+        )
+        .unwrap()
+        .into();
+    loop {
+        match vm {
+            super::super::HostVm::ReadyToRun(r) => vm = r.run(),
+            super::super::HostVm::Finished(finished) => return finished.value().as_ref().to_vec(),
+            super::super::HostVm::GetMaxLogLevel(resume) => vm = resume.resume(0),
+            super::super::HostVm::LogEmit(log) => vm = log.resume(),
+            _ => panic!(),
+        }
+    }
+}
