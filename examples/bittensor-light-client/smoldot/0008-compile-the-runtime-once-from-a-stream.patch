+#[test]
+fn custom_sections_read_from_a_stream() {
+    use super::super::runtime_version::{
+        embedded_runtime_version_sections, find_embedded_runtime_version,
+    };
+    use super::super::zstd;
+    // Westend's runtime, zstd-compressed with the Substrate prefix.
+    let compressed = &include_bytes!("../westend-runtime-v9300.wasm")[..];
+    let full = zstd::zstd_decode_if_necessary(compressed, 50 * 1024 * 1024).unwrap();
+    let mut stream =
+        zstd::ZstdReader::new(zstd::zstd_frame(compressed).unwrap(), full.len()).unwrap();
+    let sections = embedded_runtime_version_sections(&mut stream).unwrap();
+    // Only the two sections, the same read from the stream or from the bytes.
+    assert!(sections.len() < 4096);
+    assert_eq!(
+        sections,
+        embedded_runtime_version_sections(&mut &full[..]).unwrap()
+    );
+    let expected = find_embedded_runtime_version(&full).unwrap().unwrap();
+    let found = find_embedded_runtime_version(&sections).unwrap().unwrap();
+    assert_eq!(found.as_ref(), expected.as_ref());
+
+    // A module without them gives a module without them.
+    let bare = wat::parse_str("(module)").unwrap();
+    let sections = embedded_runtime_version_sections(&mut &bare[..]).unwrap();
+    assert!(find_embedded_runtime_version(&sections).unwrap().is_none());
+
+    // A module cut short, or not a module, is refused.
+    assert!(embedded_runtime_version_sections(&mut &full[..full.len() - 1]).is_err());
+    assert!(embedded_runtime_version_sections(&mut &compressed[..]).is_err());
+    assert!(embedded_runtime_version_sections(&mut &[1, 2, 3][..]).is_err());
+}
