+#[test]
+fn reader_streams_the_same_bytes() {
+    use wasmi::Read as _;
+    let frame = &include_bytes!("./polkadot-runtime-v9160.wasm.zstd")[super::ZSTD_PREFIX.len()..];
+    let whole = super::zstd_decode(frame, 50 * 1024 * 1024).unwrap();
+    let read_all = |max_allowed| {
