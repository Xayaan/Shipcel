+/// Patch (Shipcel's Bittensor light client): if the given blob starts with [`ZSTD_PREFIX`],
+/// returns the zstd frame that follows it.
+pub(super) fn zstd_frame(data: &[u8]) -> Option<&[u8]> {
+    data.strip_prefix(&ZSTD_PREFIX[..])
+}
+
+/// Patch (Shipcel's Bittensor light client): the decompressed bytes of a zstd frame, read a step
+/// at a time, the decoder keeping only its window. Reading fails past `max_allowed` bytes, as
+/// [`zstd_decode`] does, or on invalid data, and [`ZstdReader::failed`] then says which.
+pub(super) struct ZstdReader<'a> {
+    decoder: ruzstd::decoding::StreamingDecoder<&'a [u8], ruzstd::decoding::FrameDecoder>,
+    allowed: usize,
+    /// Why reading failed, if it did.
+    pub(super) failed: Option<Error>,
+}
+
+impl<'a> ZstdReader<'a> {
+    pub(super) fn new(frame: &'a [u8], max_allowed: usize) -> Result<Self, Error> {
+        Ok(ZstdReader {
+            decoder: ruzstd::decoding::StreamingDecoder::new(frame)
+                .map_err(|_| Error::InvalidZstd)?,
+            allowed: max_allowed,
+            failed: None,
+        })
+    }
+}
+
+impl wasmi::Read for ZstdReader<'_> {
+    fn read(&mut self, buf: &mut [u8]) -> Result<usize, wasmi::errors::ReadError> {
+        // One byte more than allowed is asked for, to tell a frame that ends exactly at the limit
+        // from one that goes past it.
+        let len = core::cmp::min(buf.len(), self.allowed.saturating_add(1));
+        let read = match ruzstd::io::Read::read(&mut self.decoder, &mut buf[..len]) {
+            Ok(read) => read,
+            Err(_) => {
+                self.failed = Some(Error::InvalidZstd);
+                return Err(wasmi::errors::ReadError::UnknownError);
+            }
+        };
+        if read > self.allowed {
+            self.failed = Some(Error::TooLarge);
+            return Err(wasmi::errors::ReadError::UnknownError);
+        }
+        self.allowed -= read;
+        Ok(read)
+    }
+}
