+/// Patch (Shipcel's Bittensor light client): reads a Wasm module from `module` to its end and
+/// returns a module made of only its `runtime_version` and `runtime_apis` custom sections, for
+/// [`find_embedded_runtime_version`], without ever holding the whole module. Fails if `module`
+/// isn't a sequence of Wasm sections, or keeps one of those sections over 1 MiB.
+pub fn embedded_runtime_version_sections(
+    module: &mut impl wasmi::Read,
+) -> Result<Vec<u8>, FindEncodedEmbeddedRuntimeVersionApisError> {
+    const HEADER: &[u8; 8] = b"\0asm\x01\x00\x00\x00";
+    const MAX_KEPT: usize = 1024 * 1024;
+    let failed = FindEncodedEmbeddedRuntimeVersionApisError::FailedToParse;
+
+    // Reads into the whole of `buf`, or returns `Ok(false)` at the end of the stream before any
+    // byte was read.
+    fn fill(module: &mut impl wasmi::Read, buf: &mut [u8]) -> Result<bool, ()> {
+        let mut filled = 0;
+        while filled < buf.len() {
+            match module.read(&mut buf[filled..]) {
+                Ok(0) | Err(wasmi::errors::ReadError::EndOfStream) if filled == 0 => {
+                    return Ok(false);
+                }
+                Ok(0) | Err(_) => return Err(()),
+                Ok(n) => filled += n,
+            }
+        }
+        Ok(true)
+    }
+    // An unsigned LEB128 number, and how many bytes it took.
+    fn leb128(module: &mut impl wasmi::Read) -> Result<(usize, usize), ()> {
+        let mut value = 0usize;
+        for i in 0..5 {
+            let mut byte = [0u8];
+            if !fill(module, &mut byte)? {
+                return Err(());
+            }
+            value |= usize::from(byte[0] & 0x7f) << (7 * i);
+            if byte[0] & 0x80 == 0 {
+                return Ok((value, i + 1));
+            }
+        }
+        Err(())
+    }
+    fn skip(module: &mut impl wasmi::Read, mut len: usize) -> Result<(), ()> {
+        let mut scratch = [0u8; 4096];
+        while len > 0 {
+            let step = core::cmp::min(len, scratch.len());
+            if !fill(module, &mut scratch[..step])? {
+                return Err(());
+            }
+            len -= step;
+        }
+        Ok(())
+    }
+
+    let mut header = [0u8; 8];
+    if fill(module, &mut header) != Ok(true) || header != *HEADER {
+        return Err(failed);
+    }
+    let mut out = HEADER.to_vec();
+    loop {
+        let mut id = [0u8];
+        match fill(module, &mut id) {
+            Ok(true) => {}
+            Ok(false) => return Ok(out),
+            Err(()) => return Err(failed),
+        }
+        let (size, _) = leb128(module).map_err(|()| failed.clone())?;
+        if id[0] != 0 {
+            skip(module, size).map_err(|()| failed.clone())?;
+            continue;
+        }
+        let (name_len, name_len_bytes) = leb128(module).map_err(|()| failed.clone())?;
+        let rest = size
+            .checked_sub(name_len_bytes)
+            .and_then(|r| r.checked_sub(name_len))
+            .ok_or(failed.clone())?;
+        let mut name = [0u8; 15];
+        let wanted = if name_len <= name.len() {
+            if fill(module, &mut name[..name_len]) != Ok(true) {
+                return Err(failed);
+            }
+            matches!(&name[..name_len], b"runtime_version" | b"runtime_apis")
+        } else {
+            skip(module, name_len).map_err(|()| failed.clone())?;
+            false
+        };
+        if !wanted {
+            skip(module, rest).map_err(|()| failed.clone())?;
+            continue;
+        }
+        if size > MAX_KEPT {
+            return Err(failed);
+        }
+        let mut section = Vec::with_capacity(1 + 5 + size);
+        section.push(0);
+        let mut v = size;
+        loop {
+            let byte = (v & 0x7f) as u8;
+            v >>= 7;
+            section.push(if v == 0 { byte } else { byte | 0x80 });
+            if v == 0 {
+                break;
+            }
+        }
+        section.push(u8::try_from(name_len).unwrap_or_else(|_| unreachable!()));
+        section.extend_from_slice(&name[..name_len]);
+        let start = section.len();
+        section.resize(start + rest, 0);
+        if fill(module, &mut section[start..]) != Ok(true) {
+            return Err(failed);
+        }
+        out.extend_from_slice(&section);
+    }
+}
