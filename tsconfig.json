{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "types": ["@cloudflare/workers-types", "vite/client", "node"]
  },
  "include": [
    "src",
    "worker",
    "kits",
    "shared",
    "packages",
    "site",
    "scripts",
    "services",
    "tests",
    "vite.config.ts"
  ]
}
